def content: tag = ul();
const arr: array[string] = ["Brush teeth", "Eat breakfast", "Go for a walk"];

for(def i = 0; i < arr.length(); i++)
{
	content = content + li(arr[i]).attr("style", "color: white;");
}

body(
	div(content).attr("style", "background: rgb(48, 48, 48);")
);

print(html.construct());

println("valid execution");