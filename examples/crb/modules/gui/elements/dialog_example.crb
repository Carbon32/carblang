#include "../sixui/dialog.crb"

gui.init("Dialog", 800, 600);
gui.start();

def dlg: Dialog = Dialog(200, 150, 400, 250, "Confirm Action", "Do you want to continue?", ["Yes", "No"]);

while(gui.tick())
{
    dlg.handle();

    def clicked: string = dlg.get_clicked();
    if(!(clicked == ""))
    {
        println("Button clicked: " + clicked);
    }
}
