#include "../sixui/input.crb"

gui.init("Input", 800, 600);
gui.start();

def my_input: InputField = InputField(100, 100, 300, 50, "", false);
const enter_key: number = 257;

while(gui.tick())
{
    my_input.handle();

    if(gui.key_pressed(enter_key))
    {
        println(my_input.get_text());
    }
}