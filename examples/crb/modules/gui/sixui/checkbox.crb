#include "color.crb";

class Checkbox
{
    function init(x: number, y: number, size: number, checked: bool): Checkbox
    {
        this.x: number = x;
        this.y: number = y;
        this.size: number = size;

        this.checked: bool = checked;
        this.clicked: bool = false;

        this.rect: array[number] = [x, y, size, size];

        this.box_color: Color = Color(50, 50, 50);
        this.hover_color: Color = Color(70, 70, 70);
        this.checked_color: Color = Color(80, 160, 240);
        this.checkmark_color: Color = Color(240, 240, 240);
        this.border_color: Color = Color(120, 120, 120);
    }

    function is_hovered(): bool
    {
        return gui.rectangle_mouse_collide(this.rect);
    }

    function toggle(): nothing
    {
        this.checked = !this.checked;
    }

    function draw(): nothing
    {
        def bg: Color;
        if(this.checked)
        {
            bg = this.checked_color;
        }
        else if(this.is_hovered())
        {
            bg = this.hover_color;
        }
        else
        {
            bg = this.box_color;
        }

        gui.draw_rect_advanced(
            this.x,
            this.y,
            this.size,
            this.size,
            bg.r,
            bg.g,
            bg.b,
            0.4
        );

        if(this.checked)
        {
            def check_size: number = this.size * 0.8; // font size
            def text: string = "x";

            def text_width: number = gui.measure_text(text, check_size);
            def text_x: number = this.x + (this.size - text_width) / 2;
            def text_y: number = this.y + (this.size - check_size) / 2;

            gui.draw_text_advanced(
                text,
                text_x,
                text_y,
                check_size,
                this.checkmark_color.r,
                this.checkmark_color.g,
                this.checkmark_color.b
            );
        }
    }

    function handle(): nothing
    {
        if(this.is_hovered())
        {
            if(gui.mouse_pressed(0) and !this.clicked)
            {
                this.clicked = true;
                this.toggle();
            }
        }

        if(gui.mouse_released(0))
        {
            this.clicked = false;
        }

        this.draw();
    }

    function get_state(): bool
    {
        return this.checked;
    }

    function set_state(value: bool): nothing
    {
        this.checked = value;
    }
}