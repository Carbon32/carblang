class Color
{
    function init(r: number, g: number, b: number): Color
    {
        if((r < 0 or r > 255) or (g < 0 or g > 255) or (b < 0 or b > 255)) {
            println("RBG colors only accept values between 0 and 255");
            this.r = 0;
            this.g = 0;
            this.b = 0;
        }

        this.r = r;
        this.g = g;
        this.b = b;
    }
}