#include "button.crb";

class Dialog
{
    function init(x: number, y: number, width: number, height: number, title: string, message: string, button_texts: array[string]): Dialog
    {
        this.x: number = x;
        this.y: number = y;
        this.width: number = width;
        this.height: number = height;

        this.title: string = title;
        this.message: string = message;
        this.buttons: array[Button] = [];

        this.rect: array[number] = [x, y, width, height];

        this.bg_color: Color = Color(50, 50, 50);
        this.border_color: Color = Color(200, 200, 200);
        this.title_color: Color = Color(220, 220, 220);
        this.message_color: Color = Color(200, 200, 200);

        this.font_size_title: number = 24;
        this.font_size_message: number = 18;

        def btn_width: number = 100;
        def btn_height: number = 40;
        def spacing: number = 20;
        def total_width: number = button_texts.length() * btn_width + (button_texts.length() - 1) * spacing;
        def start_x: number = this.x + (this.width - total_width) / 2;
        def btn_y: number = this.y + this.height - btn_height - 20;

        for(def i = 0; i < button_texts.length(); i++)
        {
            def btn_x: number = start_x + i * (btn_width + spacing);
            def btn: Button = Button(btn_x, btn_y, btn_width, btn_height, button_texts[i], 20);

            btn.set_button_color(0, 200, 200);
            btn.set_button_hover_color(0, 230, 230);
            btn.set_button_clicked_color(0, 150, 150);

            btn.set_text_color(233, 233, 233);
            btn.set_text_hover_color(255, 255, 255);
            btn.set_text_clicked_color(255, 255, 255);

            this.buttons.push(btn);
        }
    }

    function draw(): nothing
    {
        gui.draw_rect_advanced(
            this.x,
            this.y,
            this.width,
            this.height,
            this.bg_color.r,
            this.bg_color.g,
            this.bg_color.b,
            0.1
        );

        gui.draw_text_advanced(
            this.title,
            this.x + 20,
            this.y + 20,
            this.font_size_title,
            this.title_color.r,
            this.title_color.g,
            this.title_color.b
        );

        def line_height: number = this.font_size_message + 5;
        def current_y: number = this.y + 60;

        def i: number = 0;
        def start: number = 0;
        def msg_len: number = this.message.length();
        while(i < msg_len or i == msg_len)
        {
            if(i == msg_len or this.message[i] == "\n")
            {
                def line: string = this.message.slice(start, i);
                gui.draw_text_advanced(
                    line,
                    this.x + 20,
                    current_y,
                    this.font_size_message,
                    this.message_color.r,
                    this.message_color.g,
                    this.message_color.b
                );
                current_y = current_y + line_height;
                start = i + 1;
            }
            i++;
        }

        for(def j = 0; j < this.buttons.length(); j++)
        {
            this.buttons[j].handle();
        }
    }

    function handle(): nothing
    {
        this.draw();
    }

    function get_clicked(): string
    {
        for(def j = 0; j < this.buttons.length(); j++)
        {
            if(this.buttons[j].clicked_once())
            {
                return this.buttons[j].button_text;
            }
        }
        return "";
    }
}