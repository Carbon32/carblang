#include "color.crb";

class InputField
{
    function init(x: number, y: number, width: number, height: number, initial_text: string, hidden: bool): InputField
    {
        this.x: number = x;
        this.y: number = y;
        this.width: number = width;
        this.height: number = height;
        this.hidden: bool = hidden;
        this.hidden_text: string = hidden ? "*" * initial_text.length() : this.hidden_text = "";

        this.text: string = initial_text;

        this.active: bool = false;
        this.clicked: bool = false;

        this.rect: array[number] = [x, y, width, height];

        this.bg_color: Color = Color(40, 40, 40);
        this.active_color: Color = Color(60, 60, 60);
        this.border_color: Color = Color(120, 120, 120);
        this.text_color: Color = Color(255, 255, 255);
        this.cursor_color: Color = Color(255, 255, 255);

        this.padding: number = 10;
        this.font_size = 20;

        this.scroll_x: number = 0;
        this.text_width: number = 0;
        this.inner_width: number = 0;

        this.cursor_x: number = 0;
        this.cursor_timer: number = 0;
        this.cursor_offset: number = 0;
        this.cursor_visible: bool = true;

        this.delay: number = 0;
        this.backspace_timer: number = 0;
        this.backspace_delay: number = 0.2;  
        this.backspace_repeat: number = 0.05;
        this.backspace_held: bool = false;
    }

    function draw(hover: bool): nothing
    {
        def bg: Color = this.active ? this.active_color : this.bg_color;

        if(!this.hidden)
        {
            this.text_width = gui.measure_text(this.text, this.font_size);
            this.inner_width = this.width - (this.padding * 2);
        }
        else
        {
            this.text_width = gui.measure_text(this.hidden_text, this.font_size);
            this.inner_width = this.width - (this.padding * 2);
        }   

        if(this.text_width > this.inner_width)
        {
            this.scroll_x = this.text_width - this.inner_width;
        }
        else
        {
            this.scroll_x = 0;
        }

        gui.draw_rect_advanced(
            this.x,
            this.y,
            this.width,
            this.height,
            bg.r,
            bg.g,
            bg.b,
            0.2
        );

        if(this.hidden)
        {
            gui.draw_text_advanced(
                this.hidden_text,
                this.x + this.padding - this.scroll_x,
                this.y + this.height / 2 - this.font_size / 2,
                this.font_size,
                this.text_color.r,
                this.text_color.g,
                this.text_color.b
            );
        }
        else
        {
            gui.draw_text_advanced(
                this.text,
                this.x + this.padding - this.scroll_x,
                this.y + this.height / 2 - this.font_size / 2,
                this.font_size,
                this.text_color.r,
                this.text_color.g,
                this.text_color.b
            );
        }
        


        if(this.active)
        {
            this.cursor_timer = this.cursor_timer + 0.05;

            if(this.cursor_timer > 1)
            {
                this.cursor_timer = 0;
                this.cursor_visible = !this.cursor_visible;
            }

            if(this.cursor_visible)
            {
                this.cursor_offset = this.text_width;

                if(this.cursor_offset > this.inner_width)
                {
                    this.cursor_offset = this.inner_width;
                }

                this.cursor_x = this.x + this.padding + this.cursor_offset;

                gui.draw_rect_advanced(
                    this.cursor_x,
                    this.y + 8,
                    2,
                    this.height - 16,
                    this.cursor_color.r,
                    this.cursor_color.g,
                    this.cursor_color.b,
                    1
                );
            }
        }
    }

    function handle(): nothing
    {
        def hover: bool = gui.rectangle_mouse_collide(this.rect);

        if(hover)
        {
            if(gui.mouse_pressed(0) and !this.clicked)
            {
                this.clicked = true;
                this.active = true;
            }

            if(gui.mouse_released(0))
            {
                this.clicked = false;
            }
        }
        else
        {
            if(gui.mouse_pressed(0))
            {
                this.active = false;
            }
        }

        if(this.active)
        {
            def char: string = gui.get_character();
            if(!(char == null))
            {
                this.text = this.text + char;
                if(this.hidden)
                {
                    this.hidden_text = this.hidden_text + "*";
                }
            }

            if(gui.key_down(259))
            {
                if(!this.backspace_held)
                {
                    this.backspace_held = true;
                    this.backspace_timer = 0;

                    if(this.text.length() > 0)
                    {
                        this.text = this.text.slice(0, this.text.length() - 1);
                    }

                    if(this.hidden and this.hidden_text.length() > 0)
                    {
                        this.hidden_text = this.hidden_text.slice(0, this.hidden_text.length() - 1);
                    }
                }
                else
                {
                    this.backspace_timer = this.backspace_timer + gui.delta();

                    if(this.backspace_timer > this.backspace_delay)
                    {
                        if(this.text.length() > 0)
                        {
                            this.text = this.text.slice(0, this.text.length() - 1);
                        }

                        if(this.hidden and this.hidden_text.length() > 0)
                        {
                            this.hidden_text = this.hidden_text.slice(0, this.hidden_text.length() - 1);
                        }

                        this.backspace_timer = this.backspace_delay - this.backspace_repeat;
                    }
                }
            }
            else
            {
                this.backspace_held = false;
                this.backspace_timer = 0;
            }
        }

        this.draw(hover);
    }

    function get_text(): string
    {
        return this.text;
    }

    function set_text(value: string): nothing
    {
        this.text = value;
    }
}