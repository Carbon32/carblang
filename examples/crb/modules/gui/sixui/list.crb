#include "color.crb";

class List
{
    function init(x: number, y: number, width: number, height: number, items: array[any], visible_items: number): List
    {
        this.x: number = x;
        this.y: number = y;
        this.width: number = width;
        this.height: number = height;
        this.items: array[any] = items;
        this.visible_items: number = visible_items;

        this.item_height: number = this.height / visible_items;
        this.selected_index: number = -1;
        this.hover_index: number = -1;

        this.rects: array[array[number]] = [];

        this.bg_color: Color = Color(40, 40, 40);
        this.hover_color: Color = Color(60, 60, 60);
        this.selected_color: Color = Color(80, 160, 240);
        this.text_color: Color = Color(220, 220, 220);

        this.font_size: number = this.item_height * 0.4;
        this.scroll_index: number = 0;
    }

    function draw(): nothing
    {
        this.rects = [];
        this.hover_index = -1;
        for(def i: number = 0; i < this.visible_items and (i + this.scroll_index) < this.items.length(); i++)
        {
            def item_index: number = i + this.scroll_index;

            def item_y: number = this.y + i * this.item_height;
            def item_rect: array[number] = [this.x, item_y, this.width, this.item_height];

            this.rects.push(item_rect);

            def hover: bool = gui.rectangle_mouse_collide(item_rect);
            if(hover)
            {
                this.hover_index = item_index;
            }

            def bg: Color;
            if(item_index == this.selected_index)
            {
                bg = this.selected_color;
            }
            else if(hover)
            {
                bg = this.hover_color;
            }
            else
            {
                bg = this.bg_color;
            }

            gui.draw_rect_advanced(
                this.x,
                item_y,
                this.width,
                this.item_height,
                bg.r,
                bg.g,
                bg.b,
                0.0
            );

            def text: string = this.items[item_index];
            def text_width: number = gui.measure_text(text, this.font_size);
            def text_x: number = this.x + (this.width - text_width) / 2;
            def text_y: number = item_y + (this.item_height - this.font_size) / 2;

            gui.draw_text_advanced(
                text,
                text_x,
                text_y,
                this.font_size,
                this.text_color.r,
                this.text_color.g,
                this.text_color.b
            );
        }
    }

    function handle(): nothing
    {
        this.draw();

        for(def i: number = 0; i < this.rects.length(); i++)
        {
            if(!(this.rects[i] == null) and gui.rectangle_mouse_collide(this.rects[i]) and gui.mouse_pressed(0))
            {
                this.selected_index = i + this.scroll_index;
            }
        }
    }

    function get_selected(): string
    {
        if((this.selected_index == 0 or this.selected_index > 0) and this.selected_index < this.items.length())
        {
            return this.items[this.selected_index];
        }
        return "";
    }

    function get_index(): number
    {
        return this.selected_index;
    }
}