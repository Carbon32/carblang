#include "color.crb";

class ToggleSwitch
{
    function init(x: number, y: number, width: number, height: number, initial_state: bool): ToggleSwitch
    {
        this.x: number = x;
        this.y: number = y;
        this.width: number = width;
        this.height: number = height;

        this.state: bool = initial_state;
        this.clicked: bool = false;

        this.rect: array[number] = [x, y, width, height];

        this.off_color: Color = Color(60, 60, 60);
        this.off_knob_color: Color = Color(180, 180, 180);

        this.on_color: Color = Color(60, 60, 60);
        this.on_knob_color: Color = Color(0, 200, 0);

        this.hover_color: Color = Color(90, 90, 90);

        this.knob_padding: number = 4;
        this.knob_size: number = this.height - this.knob_padding * 2;

        this.knob_x_current: number = this.x + this.knob_padding;
        this.animation_speed: number = 0.2;
    }

    function draw(hover: bool): nothing
    {
        def bg: Color;
        if(this.state) {
            bg = this.on_color;
        }
        else if(hover) {
            bg = this.hover_color;
        }
        else {
            bg = this.off_color;
        }

        gui.draw_rect_advanced(
            this.x,
            this.y,
            this.width,
            this.height,
            bg.r,
            bg.g,
            bg.b,
            0.8
        );

        def target_x: number = 0;
        if(this.state) {
            target_x = this.x + this.width - this.knob_size - this.knob_padding;
        }
        else {
            target_x = this.x + this.knob_padding;
        }

        this.knob_x_current = this.knob_x_current + (target_x - this.knob_x_current) * 12 * gui.delta();

        def knob_color: Color;
        if(this.state) {
            knob_color = this.on_knob_color;
        }

        else {
            knob_color = this.off_knob_color;
        }

        gui.draw_rect_advanced(
            this.knob_x_current,
            this.y + this.knob_padding,
            this.knob_size,
            this.knob_size,
            knob_color.r,
            knob_color.g,
            knob_color.b,
            0.8
        );
    }

    function handle(): nothing
    {
        def hover: bool = gui.rectangle_mouse_collide(this.rect);
        if(hover)
        {
            if(gui.mouse_pressed(0) and !this.clicked)
            {
                this.clicked = true;
                this.state = !this.state;
            }

            if(gui.mouse_released(0))
            {
                this.clicked = false;
            }

            this.draw(true);
        }
        else
        {
            this.draw(false);
        }
    }

    function get_state(): bool
    {
        return this.state;
    }

    function set_state(value: bool): nothing
    {
        this.state = value;
    }
}