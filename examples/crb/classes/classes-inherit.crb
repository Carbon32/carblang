// This example uses the partially implemented type checking system

class Person {
	function init(name): instance {
		this.name = name;
	}

	function get_name(): string {
		return "Name: John";
	}

	function get_age(): string {
		return "Age: 28";
	}

	function get_job(): string {
		return "Job: Miner";
	}
}

class Worker : Person {
	function print_name(): nothing {
		printf("The name is %\n", this.name);
  
	}
}

def john = Worker("John");
printf("%, %, %\n", john.get_name(), john.get_age(), john.get_job());
john.print_name();
