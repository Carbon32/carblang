// This example uses the partially implemented type checking system

class Vehicle {
	function init(horse_power, color): instance {
		class Engine {
			function init(horse_power): any {
				if(horse_power > 5000)
				{
					println("Too much horse power was given");
					return;

				}

				this.horse_power = horse_power;
			}
		}

		class Color {
			function init(r: number, g: number, b: number): any {
				if((r > 255 or r < 0) or (g > 255 or g < 0) or (b > 255 or b < 0)) {
					println("Invalid colors");
					return;
				}

				this.r = r;
				this.g = g;
				this.b = b;
			}
		}

		this.engine = Engine(horse_power);
		this.color = Color(color[0], color[1], color[2]);
	}

	function print_information(type: string): nothing {
		if(type == "raw") {
			function vehicle_information_raw(obj: instance): nothing {
				printf("\nRaw Data:\nThe Engine: %\nColor: %\n", obj.engine, obj.color);
			}
			vehicle_information_raw(this);
			return;
		}

		if(type == "clean") {
			function vehicle_information_clean(obj: instance): nothing {
				def local_engine: string = "No engine";
				def local_color: string = "No color";
				if(!(obj.engine == null)) {
					local_engine = obj.engine.horse_power;
				}

				if(!(obj.color == null)) {
					local_color = obj.color.r + " " + obj.color.g + " " + obj.color.b;
				}

				printf("\nClean Data:\nThe Engine: %\nColor: %\n", local_engine, local_color);
			}
			vehicle_information_clean(this);
			return;
		}

		else {
			println("Invalid type");
		}
	}
	
}

def v = Vehicle(501, [255, 144, 65]);
v.print_information("raw");
v.print_information("clean");
v.print_information("whatever");