// This example uses the partially implemented type checking system

class Person {
	function init(name, age): instance {
		class Human {
			function init(name, age): instance {
				this.name = name;
				this.age = age;
			}

			function print_values(): nothing {
				printf("Name: %\nAge: %", this.name, this.age);
			}
		}

		this.human = Human(name, age);
	}
}

def person = Person("John", 28);
person.human.print_values();