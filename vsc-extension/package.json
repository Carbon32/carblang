{
    "name": "carblang",
    "displayName": "Carblang",
    "description": "Language support for Carblang source files.",
    "version": "1.0.0",
    "engines": {
        "vscode": "^1.120.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "carblang",
                "aliases": [
                    "Carblang",
                    "carblang"
                ],
                "extensions": [
                    ".crb"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "carblang",
                "scopeName": "source.carblang",
                "path": "./syntaxes/carblang.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "carblang",
                "path": "./snippets/carblang.json"
            }
        ]
    }
}